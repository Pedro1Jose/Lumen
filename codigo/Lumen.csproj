<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImportWindowsDesktopTargets>false</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen</RootNamespace>
    <ApplicationIcon>Assets\lumen.ico</ApplicationIcon>
    <Product>Lumen</Product>
    <Version>0.5.1</Version>
    <Company>Lumen</Company>
    <Description>Lumen - versículo do dia</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\versiculos.json" LogicalName="versiculos.json" />
    <EmbeddedResource Include="Assets\lumen.ico" LogicalName="lumen.ico" />
    <EmbeddedResource Include="Assets\lumen.png" LogicalName="lumen.png" />
    <EmbeddedResource Include="Assets\biblia.json" LogicalName="biblia.json" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <!-- O texto completo da Bíblia (Matos Soares) não fica no repositório: é baixado da fonte no primeiro build. -->
  <PropertyGroup>
    <BibliaUrl>https://raw.githubusercontent.com/Dancrf/biblia-db/c5feefffc2d940efa7b11c49445c52ea1426d6a4/biblia.json</BibliaUrl>
  </PropertyGroup>
  <Target Name="BaixarBiblia" BeforeTargets="BeforeBuild;PrepareForBuild" Condition="!Exists('$(MSBuildProjectDirectory)\Assets\biblia.json')">
    <DownloadFile SourceUrl="$(BibliaUrl)" DestinationFolder="$(MSBuildProjectDirectory)\Assets" DestinationFileName="biblia.json" />
  </Target>
</Project>
